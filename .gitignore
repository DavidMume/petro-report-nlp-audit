# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Environment / secrets ---
.env
.env.*
*.key
secrets.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Data (raw source material is tracked deliberately; large derived
#     artefacts and caches are not — see data/raw/README.md for the
#     immutability policy on raw inputs) ---
data/interim/*
!data/interim/.gitkeep
# parquet twins of committed CSVs are regenerated by `make corpus`
data/processed/*.parquet
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Large model / embedding caches
*.bin
*.safetensors
.cache/
models_cache/

# --- Outputs: charts, networks and tables ARE committed (small, reviewable on
#     GitHub, and needed by the web app); they are fully regenerated by `make all`.

# --- Node (web/ app) ---
web/node_modules/
web/dist/
web/.vite/

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Detector calibration: downloaded control PDFs are not redistributed
#     (URLs + SHA-256 are in sources/calibration/A_human/downloads.csv) ---
sources/calibration/A_human/pdf/
.venv-detectors/
outputs/tables/*_dryrun*
outputs/charts/*_dryrun*
