# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Environment / secrets ---
.env
.env.*
*.key
secrets.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Data (raw source material is tracked deliberately; large derived
#     artefacts and caches are not — see data/raw/README.md for the
#     immutability policy on raw inputs) ---
data/interim/*
!data/interim/.gitkeep
data/processed/*.parquet
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Large model / embedding caches
*.bin
*.safetensors
.cache/
models_cache/

# --- Outputs that are regenerated by `make` targets ---
outputs/charts/*.png
outputs/charts/*.svg
!outputs/charts/.gitkeep
outputs/networks/*.graphml
!outputs/networks/.gitkeep

# --- Node (web/ app) ---
web/node_modules/
web/dist/
web/.vite/

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
